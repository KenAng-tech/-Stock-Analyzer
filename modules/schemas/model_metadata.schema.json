{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modules/schemas/model_metadata.schema.json",
  "title": "SOTA 模型元数据",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "trained"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "trained": { "type": "boolean" },
    "last_trained": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "regime": { "enum": ["bull", "bear", "sideways"] },
    "direction": { "enum": ["up", "down", "neutral"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
