{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modules/schemas/analysis_result.schema.json",
  "title": "分析报告结构",
  "type": "object",
  "additionalProperties": false,
  "required": ["basic_info", "prediction"],
  "properties": {
    "basic_info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code", "price", "date"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "code": {
          "type": "string",
          "pattern": "^(sh|sz|bj)(6\\d{5}|0\\d{5}|3\\d{5}|8\\d{5})$"
        },
        "price": { "type": "number", "minimum": 0 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
        "cost_basis": { "type": "number" }
      }
    },
    "prediction": {
      "type": "object",
      "required": ["model", "kelly", "sota_models"],
      "properties": {
        "model": {
          "type": "object",
          "properties": {
            "composite": { "type": "number" },
            "ml_direction": { "enum": ["up", "down", "neutral"] },
            "ml_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "kelly": { "type": "object" },
        "sota_models": { "type": "object" }
      }
    },
    "fundamental": { "type": "object" },
    "technical": { "type": "object" },
    "fund_flow": { "type": "object" },
    "profit_analysis": { "type": "object" }
  }
}
